{
  "name": "network-study",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "content": "python3 ../tools/build_app_content.py",
    "dev": "npm run content && vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run content && tsc -b && vite build",
    "start": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "pretest": "npm run content",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "mermaid": "^12.2.0",
    "katex": "^0.19.0",
    "idb": "^8.0.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.468.0"
  },
  "overrides": { "katex": "$katex" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "fake-indexeddb": "^6.0.0",
    "@playwright/test": "^1.58.0"
  }
}
